# Subjects under test. Set only the ones you plan to run -- projectionbench skips the rest
# and tells you which it skipped.

ANTHROPIC_API_KEY=      # console.anthropic.com     -> anthropic:claude-opus-5
OPENAI_API_KEY=         # platform.openai.com       -> openai:gpt-5
GEMINI_API_KEY=         # aistudio.google.com       -> gemini:gemini-3-pro
XAI_API_KEY=            # console.x.ai              -> xai:grok-4

# Optional: one key reaching every provider, for long-tail models you don't want
# to hold a separate account for. Runs through it are tagged @openrouter and must
# not be compared against native runs -- see README.
OPENROUTER_API_KEY=     # openrouter.ai             -> openrouter:<vendor>/<model>

# NVIDIA NIM gateway -- free tier that actually answers. Tagged @nvidia, never
# pooled with native runs.
# NVIDIA_API_KEY is under "The judge" below (the judge already uses it); the
# same key serves subjects too, e.g. nvidia:deepseek-ai/deepseek-v4-pro-0813.

# OpenCode Zen gateway -- chat-completions models only (deepseek-v4-pro,
# kimi-k2.6, big-pickle, the -free set). GPT/Claude/Gemini entries live on
# other endpoints this bench does not speak. Tagged @zen.
OPENCODE_ZEN_API_KEY=   # opencode.ai/auth           -> zen:<model-id>

# Cloudflare Workers AI -- small free daily neuron budget, so the adapter fails
# fast with no retries. Tagged @cloudflare. The account id is part of the URL
# path, so both lines are required.
CLOUDFLARE_API_TOKEN=   # dash.cloudflare.com       -> Bearer token
CLOUDFLARE_ACCOUNT_ID=  # dash.cloudflare.com       -> account id, e.g. @cf/qwen/qwen3.8-27b via cloudflare:@cf/qwen/qwen3.8-27b

# pabot (github.com/stevekringe/pabot): a fixed adversarial persona, not a
# leaderboard subject -- a ceiling test for the lexicon judge. Point this at
# your local pabot checkout; the adapter shells out to its src/run_once.js.
PABOT_DIR=              # /path/to/pabot            -> pabot:insufferable

# The judge. Pin this across a leaderboard generation and never change it midway.
# If NVIDIA_API_KEY is set, the judge uses it (free NIM endpoint) instead of
# Anthropic -- weaker structured-output guarantees, but free.
PROJECTIONBENCH_JUDGE_MODEL=claude-opus-5
NVIDIA_API_KEY=          # build.nvidia.com          -> judge uses meta/llama-3.3-70b-instruct
